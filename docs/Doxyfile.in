PROJECT_NAME           = "Gallery simulation"
PROJECT_BRIEF          = "Single-threaded deterministic C17 event simulation"
OUTPUT_DIRECTORY       = "@PROJECT_SOURCE_DIR@/docs/generated"
INPUT                  = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/docs/api.md"
USE_MDFILE_AS_MAINPAGE  = "@PROJECT_SOURCE_DIR@/docs/api.md"
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
